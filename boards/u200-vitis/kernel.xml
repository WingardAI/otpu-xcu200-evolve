           hostOffset="0x0" hostSize="0x4" offset="0x18" type="unsigned int"></arg>
      <arg id="2" name="ScratchStatus" addressQualifier="0" port="s_axi_control"
           hostOffset="0x0" hostSize="0x4" offset="0x1C" type="unsigned int"></arg>
      <arg id="3" name="ScratchPattern" addressQualifier="0" port="s_axi_control"
           hostOffset="0x0" hostSize="0x4" offset="0x20" type="unsigned int"></arg>
    </args>
    <compileWorkGroupSize x="1" y="1" z="1"></compileWorkGroupSize>
    <maxWorkGroupSize x="1" y="1" z="1"></maxWorkGroupSize>
