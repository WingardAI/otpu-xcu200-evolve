<?xml version="1.0" encoding="UTF-8"?>
<root versionMajor="1" versionMinor="0">
  <kernel name="OtpuKernel" language="ip_c" vlnv="xilinx.com:RTLKernel:OtpuKernel:1.0"
          attributes="" preferredWorkGroupSizeMultiple="0" workGroupSize="1" interrupt="true">
    <ports>
      <port name="m_axi_bank_0" portType="addressable" mode="master"
            base="0x0" range="0xFFFFFFFFFFFFFFFF" dataWidth="512"></port>
      <port name="s_axi_control" portType="addressable" mode="slave"
            base="0x0" range="0x1000" dataWidth="32"></port>
    </ports>
    <args>
